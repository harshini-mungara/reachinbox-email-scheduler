# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# For local run or Docker Compose
DATABASE_URL="postgresql://reachinbox_user:reachinbox_password@localhost:5432/reachinbox_db?schema=public"

# Redis Configuration (BullMQ and Rate Limiter)
REDIS_URL="redis://localhost:6379"

# Worker Configurations
WORKER_CONCURRENCY=5

# Global Rate Limiting default (emails per hour per user)
MAX_EMAILS_PER_HOUR=200

# Authentication (JWT verification shared with NextAuth)
NEXTAUTH_SECRET="your-nextauth-secret-minimum-32-characters"
# Google client details can be set here if backend performs direct OAuth actions
# GOOGLE_CLIENT_ID="your-google-client-id"
# GOOGLE_CLIENT_SECRET="your-google-client-secret"
